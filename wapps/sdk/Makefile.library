# Geogram WASM SDK — library module build rules
#
# Usage: In your library module Makefile, set MODULE_NAME and MODULE_SRCS, then:
#   include ../../sdk/Makefile.library
#
# Same as Makefile.common but exports library-specific symbols:
#   module_type, module_api_schema, module_invoke

WASI_SDK_PATH ?= /opt/wasi-sdk
CC := $(WASI_SDK_PATH)/bin/clang
HAL_DIR := $(dir $(lastword $(MAKEFILE_LIST)))../hal

CFLAGS := \
	--target=wasm32-wasi \
	-O2 -flto \
	-I$(HAL_DIR) \
	-Wall -Wextra -Werror \
	-fno-exceptions \
	-DNDEBUG

LDFLAGS := \
	--target=wasm32-wasi \
	-flto \
	-Wl,--no-entry \
	-Wl,--export=module_init \
	-Wl,--export=module_destroy \
	-Wl,--export=module_type \
	-Wl,--export=module_api_schema \
	-Wl,--export=module_invoke \
	-Wl,--strip-all \
	-nostartfiles

OUTPUT := $(MODULE_NAME).wasm

.PHONY: all clean

all: $(OUTPUT)

$(OUTPUT): $(MODULE_SRCS)
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $^
	@echo "Built $(OUTPUT) ($$(wc -c < $(OUTPUT)) bytes)"

clean:
	rm -f $(OUTPUT)
