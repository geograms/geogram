[
  {
    "$": "screen",
    "name": "@screen.map",
    "tip": "@screen.map_tip",
    "children": [
      {
        "$": "group",
        "name": "map-viewport",
        "$type": "map",
        "tile-url": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
        "default-lat": 38.7223,
        "default-lon": -9.1393,
        "default-zoom": 12,
        "min-zoom": 2,
        "max-zoom": 18
      },
      {
        "$": "group",
        "name": "@group.controls",
        "children": [
          {
            "$": "action",
            "name": "zoom-in",
            "label": "+",
            "style": "primary",
            "tip": "@action.zoom_in_tip"
          },
          {
            "$": "action",
            "name": "zoom-out",
            "label": "-",
            "style": "primary",
            "tip": "@action.zoom_out_tip"
          }
        ]
      }
    ]
  },
  {
    "$": "screen",
    "name": "@screen.settings",
    "tip": "@screen.settings_tip",
    "children": [
      {
        "$": "group",
        "name": "@group.tiles",
        "tip": "@group.tiles_tip",
        "children": [
          {
            "$": "field",
            "name": "tileServer",
            "$type": "enum",
            "label": "@field.tile_source",
            "default": "satellite",
            "children": [
              { "$": "option", "name": "satellite", "label": "@option.satellite" },
              { "$": "option", "name": "osm", "label": "@option.osm" },
              { "$": "option", "name": "topo", "label": "@option.topo" }
            ]
          }
        ]
      },
      {
        "$": "group",
        "name": "@group.cache",
        "tip": "@group.cache_tip",
        "children": [
          {
            "$": "field",
            "name": "cacheEnabled",
            "$type": "bool",
            "label": "@field.cache_enabled",
            "default": true,
            "tip": "@field.cache_enabled_tip"
          },
          {
            "$": "field",
            "name": "maxCacheMb",
            "$type": "int",
            "label": "@field.cache_max",
            "default": 200,
            "min": 50,
            "max": 2000,
            "step": 50,
            "tip": "@field.cache_max_tip"
          }
        ]
      },
      {
        "$": "action",
        "name": "save",
        "label": "@action.save",
        "style": "primary",
        "tip": "@action.save_tip"
      },
      {
        "$": "action",
        "name": "cancel",
        "label": "@action.cancel",
        "style": "secondary"
      }
    ]
  }
]
