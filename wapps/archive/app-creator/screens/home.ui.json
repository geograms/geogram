[
  {
    "$": "screen",
    "name": "@screen.projects",
    "tip": "@screen.projects_tip",
    "children": [
      {
        "$": "group",
        "name": "@group.projects",
        "$type": "projects",
        "tip": "@group.projects_tip"
      }
    ]
  },
  {
    "$": "screen",
    "name": "@screen.code",
    "tip": "@screen.code_tip",
    "children": [
      {
        "$": "field",
        "name": "source",
        "$type": "code",
        "label": "source.c",
        "language": "c",
        "tip": "@field.source_tip",
        "default": "#include \"geogram_wasm_hal.h\"\n\nstatic unsigned str_len(const char *s) {\n    unsigned n = 0;\n    while (s[n]) n++;\n    return n;\n}\n\nvoid module_init(void) {\n    const char *msg = \"[my-first] init\";\n    hal_log(1, msg, str_len(msg));\n}\n\nvoid module_tick(void) {\n    const char *msg = \"[my-first] tick\";\n    hal_log(0, msg, str_len(msg));\n}\n\nvoid module_handle_event(void) { }\nvoid module_destroy(void) { }\n\nuint32_t module_tick_interval_ms(void) {\n    return 5000;\n}\n"
      },
      {
        "$": "action",
        "name": "compile",
        "label": "@action.compile",
        "style": "primary",
        "tip": "@action.compile_tip"
      },
      {
        "$": "action",
        "name": "install",
        "label": "@action.install",
        "style": "secondary",
        "tip": "@action.install_tip"
      },
      {
        "$": "field",
        "name": "output",
        "$type": "log",
        "label": "@field.compiler_output",
        "tip": "@field.compiler_output_tip"
      }
    ]
  },
  {
    "$": "screen",
    "name": "@screen.ui",
    "tip": "@screen.ui_tip",
    "children": [
      {
        "$": "group",
        "name": "ui",
        "$type": "ui-editor",
        "tip": "@group.ui_editor_tip"
      }
    ]
  },
  {
    "$": "screen",
    "name": "@screen.translations",
    "tip": "@screen.translations_tip",
    "children": [
      {
        "$": "group",
        "name": "translations",
        "$type": "translations",
        "tip": "@group.translations_tip"
      }
    ]
  },
  {
    "$": "screen",
    "name": "@screen.settings",
    "tip": "@screen.settings_tip",
    "children": [
      {
        "$": "group",
        "name": "@group.identity",
        "tip": "@group.identity_tip",
        "children": [
          {
            "$": "field",
            "name": "wapp_title",
            "$type": "string",
            "label": "@field.title",
            "default": "My first wapp",
            "tip": "@field.title_tip"
          },
          {
            "$": "field",
            "name": "wapp_name",
            "$type": "string",
            "label": "@field.name",
            "default": "my-first",
            "tip": "@field.name_tip"
          },
          {
            "$": "field",
            "name": "wapp_id",
            "$type": "string",
            "label": "@field.id",
            "default": "user.geogram.my-first",
            "tip": "@field.id_tip"
          },
          {
            "$": "field",
            "name": "wapp_description",
            "$type": "string",
            "label": "@field.description",
            "default": "A wapp I wrote inside geogram.",
            "tip": "@field.description_tip"
          },
          {
            "$": "field",
            "name": "wapp_icon",
            "$type": "icon",
            "label": "@field.icon",
            "default": "",
            "tip": "@field.icon_tip"
          }
        ]
      }
    ]
  }
]
