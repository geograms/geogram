[
  {
    "$": "screen",
    "name": "Archive",
    "tip": "Browse and install wapps from a repository.",
    "children": [
      {
        "$": "group",
        "name": "output-list",
        "$type": "output",
        "tip": "Wapp catalog and status messages."
      }
    ]
  },
  {
    "$": "screen",
    "name": "Settings",
    "tip": "Installer settings.",
    "children": [
      {
        "$": "group",
        "name": "Source",
        "tip": "Wapp repository location.",
        "children": [
          {
            "$": "field",
            "name": "source",
            "$type": "string",
            "label": "Repository",
            "default": "",
