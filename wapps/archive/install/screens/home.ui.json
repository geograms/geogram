          }
        ]
      },
      {
        "$": "action",
        "name": "save",
        "label": "Save",
        "style": "primary",
        "tip": "Apply settings."
      },
      {
        "$": "action",
        "name": "cancel",
        "label": "Cancel",
        "style": "secondary"
      }
    ]
  }
