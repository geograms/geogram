app "Terminal" {
  version:  0.8;
  base-url: /api;
  tip:      "Self-contained terminal. All commands run in the WASM sandbox.";

  icons {
    set file  { for: web, lvgl, email; }
    set emoji { for: web, cli, email, lvgl; }
    set text  { for: cli, email; }
  }

  include "screens/settings.ui";

  screen "Terminal" {
    tip: "Execute commands and view output.";

    group "Output" {
      tip: "Command output appears here.";

      watch {
        endpoint: /output;
        interval: 500ms;
        params {
          after: state(last_output_id);
        }

        result {
          type:  list;
          id:    output-list;
          empty: "Type a command below to get started.";

          200 {
            strategy: append-new;
            track-by: response(id);
            scroll:   bottom;
            update:   state(last_output_id) <- response(last_id);
          }
          4xx { type: toast; message: response(error); level: warning; }
          5xx { type: toast; message: "Output fetch failed."; level: error; }

          item {
            title:    response(text);
            subtitle: response(level);

            icon {
              from:  response(level);
              emoji: >, !, *;
              text:  [out], [err], [cmd];
            }
          }
        }
      }
    }

    group "Input" {
      tip: "Enter commands here.";

      label prompt {
        text:  "$ ";
        style: meta;
      }

      field command : string {
        label:    "Command";
        default:  "";
        required: true;
        hint:     "ls, cd, cat, ping, curl, help ...";
        icon {
          file:  media(terminal.svg);
          emoji: >;
          text:  [$];
        }
      }
    }

    action run {
      label:   "Run";
      style:   primary;
      confirm: false;
      tip:     "Execute the command.";

      icon {
        file:  media(terminal.svg);
        emoji: >;
        text:  [run];
      }

      request {
        method:   POST;
        endpoint: /exec;
        body {
          command: field(command);
        }
      }

      result {
        optimistic {
          type:   mutation;
          target: output-list;
          op:     append;
          item {
            text:    field(command);
            level:   cmd;
            pending: true;
          }
        }
        200 {
          type:   mutation;
          target: output-list;
          op:     append;
          item {
            text:  response(output);
            level: response(level);
          }
          then: clear(field(command));
        }
        4xx {
          type:   mutation;
          target: output-list;
          op:     append;
          item {
            text:  response(error);
            level: err;
          }
        }
        5xx {
          type:   mutation;
          target: output-list;
          op:     append;
          item {
            text:  "Command failed.";
            level: err;
          }
        }
      }
    }

    action clear-screen {
      label: "Clear";
      style: secondary;
      tip:   "Clear the output buffer.";

      icon {
        emoji: X;
        text:  [clr];
      }

      request {
        method:   POST;
        endpoint: /clear;
      }

      result {
        200 {
          type:   mutation;
          target: output-list;
          op:     clear;
        }
      }
    }
  }
}
