[
  {
    "$": "screen",
    "name": "@screen.settings",
    "tip": "@screen.settings_tip",
    "children": [
      {
        "$": "group",
        "name": "@group.appearance",
        "tip": "@group.appearance_tip",
        "children": [
          {
            "$": "field",
            "name": "fontSize",
            "$type": "float",
            "label": "@field.font_size",
            "default": 16.0,
            "min": 10,
            "max": 32,
            "step": 1,
            "tip": "@field.font_size_tip"
          },
          {
            "$": "field",
            "name": "fontFamily",
            "$type": "enum",
            "label": "@field.font_family",
            "default": "RobotoMono",
            "children": [
              { "$": "option", "name": "RobotoMono", "label": "Roboto Mono" },
              { "$": "option", "name": "Courier", "label": "Courier" },
              { "$": "option", "name": "monospace", "label": "Monospace" }
            ]
          },
          {
            "$": "field",
            "name": "lineHeight",
            "$type": "float",
            "label": "@field.line_height",
            "default": 1.5,
            "min": 1.0,
            "max": 2.5,
            "step": 0.1,
            "tip": "@field.line_height_tip"
          },
          {
            "$": "field",
            "name": "colorScheme",
            "$type": "enum",
            "label": "@field.color_scheme",
            "default": "dark",
            "children": [
              { "$": "option", "name": "dark", "label": "@option.dark" },
              { "$": "option", "name": "light", "label": "@option.light" },
              { "$": "option", "name": "solarized", "label": "@option.solarized" }
            ]
          }
        ]
      },
      {
        "$": "group",
        "name": "@group.behavior",
        "tip": "@group.behavior_tip",
        "children": [
          {
            "$": "field",
            "name": "showTimestamps",
            "$type": "bool",
            "label": "@field.show_timestamps",
            "default": false,
            "tip": "@field.show_timestamps_tip"
          },
          {
            "$": "field",
            "name": "maxLines",
            "$type": "int",
            "label": "@field.buffer_size",
            "default": 5000,
            "min": 500,
            "max": 20000,
            "step": 500,
            "tip": "@field.buffer_size_tip"
          }
        ]
      },
      {
        "$": "action",
        "name": "save",
        "label": "@action.save_settings",
        "style": "primary",
        "tip": "@action.save_settings_tip",
        "children": [
          {
            "$": "icon",
            "emoji": "V",
            "text": "[save]"
          },
          {
            "$": "request",
            "method": "POST",
            "endpoint": "/settings",
            "children": [
              {
                "$": "body",
                "fontSize": { "$fn": "field", "args": ["fontSize"] },
                "fontFamily": { "$fn": "field", "args": ["fontFamily"] },
                "lineHeight": { "$fn": "field", "args": ["lineHeight"] },
                "colorScheme": { "$fn": "field", "args": ["colorScheme"] },
                "showTimestamps": { "$fn": "field", "args": ["showTimestamps"] },
                "maxLines": { "$fn": "field", "args": ["maxLines"] }
              }
            ]
          },
          {
            "$": "result",
            "children": [
              { "$": "200", "type": "toast", "message": "Settings saved.", "level": "success" },
              { "$": "4xx", "type": "toast", "message": { "$fn": "response", "args": ["error"] }, "level": "warning" },
              { "$": "5xx", "type": "toast", "message": "Could not save settings.", "level": "error" }
            ]
          }
        ]
      },
      {
        "$": "action",
        "name": "cancel",
        "label": "@action.cancel",
        "style": "secondary",
        "tip": "@action.cancel_tip"
      }
    ]
  }
]
