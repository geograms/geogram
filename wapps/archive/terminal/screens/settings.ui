screen "Settings" {
  tip: "Configure terminal appearance and behavior.";

  group "Appearance" {
    tip: "Font and display settings.";

    field fontSize : float {
      label:   "Font Size";
      default: 16.0;
      min:     10;
      max:     32;
      step:    1;
      tip:     "Size of the terminal font in pixels.";
    }

    field fontFamily : enum {
      label:   "Font Family";
      default: RobotoMono;

      option RobotoMono  { label: "Roboto Mono"; }
      option Courier     { label: "Courier"; }
      option monospace   { label: "Monospace"; }
    }

    field lineHeight : float {
      label:   "Line Height";
      default: 1.5;
      min:     1.0;
      max:     2.5;
      step:    0.1;
      tip:     "Vertical spacing between lines.";
    }

    field colorScheme : enum {
      label:   "Color Scheme";
      default: dark;

      option dark      { label: "Dark"; }
      option light     { label: "Light"; }
      option solarized { label: "Solarized"; }
    }
  }

  group "Behavior" {
    tip: "Terminal output settings.";

    field showTimestamps : bool {
      label:   "Show Timestamps";
      default: false;
      tip:     "Display time next to each output line.";
    }

    field maxLines : int {
      label:   "Buffer Size";
      default: 5000;
      min:     500;
      max:     20000;
      step:    500;
      tip:     "Maximum number of lines kept in the terminal buffer.";
    }
  }

  action save {
    label: "Save Settings";
    style: primary;
    tip:   "Write settings to persistent storage.";

    icon {
      emoji: V;
      text:  [save];
    }

    request {
      method:   POST;
      endpoint: /settings;
      body {
        fontSize:       field(fontSize);
        fontFamily:     field(fontFamily);
        lineHeight:     field(lineHeight);
        colorScheme:    field(colorScheme);
        showTimestamps: field(showTimestamps);
        maxLines:       field(maxLines);
      }
    }

    result {
      200 { type: toast; message: "Settings saved.";         level: success; }
      4xx { type: toast; message: response(error);           level: warning; }
      5xx { type: toast; message: "Could not save settings."; level: error;  }
    }
  }

  action cancel {
    label: "Cancel";
    style: secondary;
    tip:   "Discard changes.";
  }
}
